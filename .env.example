# Credenciales de Telematel ERP (Progress OpenEdge) — SOLO en el servidor.
# Nunca se empaquetan en el cliente. Copia este fichero a .env y rellena los valores.

# DSN ODBC principal (carga completa / catálogos)
TLM_DSN=tlmplusV11
TLM_USER=userSQL
TLM_PASSWORD=userSQL

# DSN ODBC secundario (incremental)
TLM_DSN_INCREMENTAL=tlmplus1V11

# Host mostrado en la UI (no sensible, informativo)
TLM_HOST_NAME=dataserver
TLM_HOST_IP=192.168.1.3